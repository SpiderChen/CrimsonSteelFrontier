static func ids() -> Array:
	var result: Array = SCENES.keys()
	for pilot in range(preload("res://scripts/pilot_roster.gd").TASKS.size()):
		for chapter in range(3):
			result.append("personal_%d_%d"%[pilot,chapter]); result.append("talk_%d_%d"%[pilot,chapter])
	return result

static func scene(id: String) -> Dictionary:
	if SCENES.has(id):
		var result: Dictionary = SCENES[id].duplicate(true)
		if FROST_LINES.has(id): result.guest_line = FROST_LINES[id]
		return result
	var pieces := id.split("_")
	if pieces.size()!=3 or pieces[0] not in ["personal","talk"] or not pieces[1].is_valid_int() or not pieces[2].is_valid_int(): return {}
	var pilot := int(pieces[1]); var chapter := int(pieces[2])
	if pilot<0 or pilot>=preload("res://scripts/pilot_roster.gd").TASKS.size() or chapter<0 or chapter>2: return {}
	var roster = preload("res://scripts/pilot_roster.gd")
	var personal: bool = pieces[0]=="personal"
	var text: String = roster.TASKS[pilot][chapter].story if personal else roster.TALKS[pilot][chapter]
	var answers := ["你不需要每次都越过红线。把判断告诉我，我们一起决定。","不用独自确认所有事情。你看到的路，也可以交给我们一起守。","也为自己留一点余量。等大家都回来，我们一起休息。","不必每次都走在最前面。下一步，我陪你一起练。","我们会回应你的坐标。那条返航线，也属于你。","给设备留余量，也给自己留一个不用值班的早晨。"]
	var replies := ["那下次试飞，你来签检查单的最后一栏。","好。下一次，我会先打开小队频道。","约好了。那杯热饮，我也给自己留一杯。","好。这次没有教官，只有并肩前进的队友。","那我就在星图旁边，给你也留一个位置。","约好了。等日出的时候，我会放下工具。"]
	return {"title":roster.TASKS[pilot][chapter].name if personal else "机库交流 · %d"%(chapter+1),"place":"绯红方舟 / 机师休息室","cast":[pilot],"lines":[[-2,text] if personal else [pilot,text],[-1,answers[pilot]],[pilot,replies[pilot]]]}
